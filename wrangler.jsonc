{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ashabi",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ashabi.cloud"
  },
  "routes": [
    { "pattern": "ashabi.cloud", "custom_domain": true },
    { "pattern": "www.ashabi.cloud", "custom_domain": true }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ashabi",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ashabi.cloud",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGAvMGCWJm0QJgYN"
  },
  "routes": [
    { "pattern": "ashabi.cloud/*", "zone_id": "0eed97c107c4c3c5bb2e0622db13e517" },
    { "pattern": "www.ashabi.cloud/*", "zone_id": "0eed97c107c4c3c5bb2e0622db13e517" }
  ]
}
